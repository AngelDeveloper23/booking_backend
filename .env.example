# Copy this file to .env before running the backend

# SQLite database file (relative to backend/prisma)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
# Also used to build the password reset link (no email service is
# configured for this MVP — reset links are logged to this server's
# console instead; see docs/ARCHITECTURE.md).
CORS_ORIGIN="http://localhost:5173"
